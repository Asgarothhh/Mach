[Unit]
Description=TTS Playground (MTS voice agent ML demo, on-demand synthesis)
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/home/eq/techlb/Mach
ExecStart=/home/eq/techlb/Mach/.venv/bin/python -u apps/tts_playground/server.py --host 100.64.0.4 --port 8077
Restart=on-failure
RestartSec=5
Nice=5

[Install]
WantedBy=default.target
