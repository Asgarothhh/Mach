# true = интерфейс работает в явном демонстрационном режиме без backend/LLM.
# false = используются реальные API. Голос идёт по WS mock-каналу, пока LiveKit не настроен.
VITE_DEMO_MODE=true

# Публичный URL вашего FastAPI API. Префикс /api/v1 уже входит в базовый URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Публичный WebSocket URL LiveKit (НЕ API key / secret).
# Пусто = browser test channel / mock WS на /api/v1/ws/sessions/{id}. Не телефония.
VITE_LIVEKIT_URL=

VITE_APP_NAME=MTS Inbound Voice Agent

# Route the Text mode through FastAPI POST /sessions/{id}/turns/text.
# This is not microphone audio, SIP, or LiveKit media.
VITE_BACKEND_TEXT_TEST=false
VITE_BACKEND_ADMIN_SESSIONS=false
# Live API tenants on main: acme-it-demo | mts-public-demo
VITE_BACKEND_TEST_TENANT_ID=acme-it-demo
