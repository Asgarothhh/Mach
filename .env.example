# Copy to .env and fill in local values. Do not commit .env.

ENVIRONMENT=demo
LOG_LEVEL=INFO
APP_PUBLIC_ORIGIN=http://localhost:3000

POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=voice_agent
# Host processes use localhost. Compose services override this to hostname postgres.
# Compose publishes Postgres on host :5433 (container still listens on 5432) so a
# local cluster on :5432 is not required and is not overwritten.
DATABASE_URL=postgresql+asyncpg://admin:CHANGE_ME@localhost:5433/voice_agent
SYNC_DATABASE_URL=postgresql+psycopg2://admin:CHANGE_ME@localhost:5433/voice_agent

# Leave empty for the mock LLM path. API /health/ready does not require this key.
# Do not put a real API key in this file.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
# Runtime reads this. Allowlist in app/api/main.py always includes Gemma.
OPENROUTER_MODEL_ID=google/gemma-4-26b-a4b-it
OPENROUTER_REQUIRE_ZDR=false
OPENROUTER_DATA_COLLECTION=deny

# Speech cascade inside the API process. Default is mock (compose demo profile).
# Live requires conda env mach extras + scripts/fetch_models.py on the HOST.
# Weights are not downloaded on compose up.
VOICE_ASR_MODE=mock
VOICE_TTS_MODE=mock
VOICE_MOCK_ASR_TEXT=график работы офис acme

# Live host overlay (do not flip compose defaults; export on the host process):
# VOICE_ASR_MODE=live
# VOICE_TTS_MODE=real
# ASR_MODEL=t-tech/t-one
# ASR_DEVICE=cpu
# TTS_MODEL_PATH=models/tts/v5_cis_base_nostress.pt
# TTS_VOICE=ru_bogdan
# TTS_SAMPLE_RATE=24000
# VOICE_AGENT_HOST=127.0.0.1
# VOICE_AGENT_PORT=8100
# DATABASE_URL=postgresql+asyncpg://admin:CHANGE_ME@127.0.0.1:5433/voice_agent
# SYNC_DATABASE_URL=postgresql+psycopg2://admin:CHANGE_ME@127.0.0.1:5433/voice_agent

# Hybrid RAG (compose defaults these for the api service). Unset QDRANT_URL to keep the lexical stub.
# QDRANT_URL=http://127.0.0.1:6333
# REDIS_URL=redis://127.0.0.1:6379/0
# EMBEDDING_MODEL_ID=bge-m3-onnx
# RERANKER_MODEL_ID=none
