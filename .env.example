# true = интерфейс работает в явном демонстрационном режиме без backend/LLM.
# false = используются реальные API и LiveKit.
VITE_DEMO_MODE=true

# Публичный URL вашего FastAPI API. Префикс /api/v1 уже входит в базовый URL.
VITE_API_BASE_URL=http://localhost:8000/api/v1

# Публичный WebSocket URL LiveKit (НЕ API key / secret).
# Self-hosted примеры часто используют ws://localhost:7880 в локальной среде.
VITE_LIVEKIT_URL=ws://localhost:7880

VITE_APP_NAME=MTS Inbound Voice Agent

# Optional Phase-0 bridge: route the Text mode through FastAPI WebSocket using a typed ASR event.
# This is not real microphone audio, SIP, or LiveKit media.
VITE_BACKEND_TEXT_TEST=false
VITE_BACKEND_TEST_TENANT_ID=demo-business-01
