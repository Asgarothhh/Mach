# Copy to .env and fill in local values. Do not commit .env.

ENVIRONMENT=demo
LOG_LEVEL=INFO
APP_PUBLIC_ORIGIN=http://localhost:3000

POSTGRES_USER=admin
POSTGRES_PASSWORD=CHANGE_ME
POSTGRES_DB=voice_agent
DATABASE_URL=postgresql+asyncpg://admin:CHANGE_ME@localhost:5432/voice_agent
SYNC_DATABASE_URL=postgresql+psycopg2://admin:CHANGE_ME@localhost:5432/voice_agent

# Leave empty for the mock LLM path. API /health/ready does not require this key.
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1
OPENROUTER_MODEL_ID=meta-llama/llama-3-8b-instruct
OPENROUTER_REQUIRE_ZDR=false
OPENROUTER_DATA_COLLECTION=deny

# Speech cascade inside the API process. live requires extras + scripts/fetch_models.py.
VOICE_ASR_MODE=mock
VOICE_TTS_MODE=mock
VOICE_MOCK_ASR_TEXT=график работы офис acme
